<dict>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.shailpatel.LCVI-DECA-Study-App.deeplink</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>decastudy</string>
			</array>
		</dict>
	</array>
	<!-- The app's only cryptography is SHA-256 hashing of the downloaded model
	     and TLS provided by the OS, both of which are exempt. Declaring this
	     here means App Store Connect stops asking on every single upload. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- Alternate icons only. CFBundlePrimaryIcon is deliberately absent: the
	     asset catalog owns the main icon and the build injects
	     CFBundleIconName for it, which a hand-written primary entry would
	     fight with. -->
